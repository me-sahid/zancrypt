# Database
DATABASE_URL=postgresql+asyncpg://user:pass@host/db

# Security
SECRET_KEY=your-secret-key-here-min-32-chars

# Cache
REDIS_URL=redis://localhost:6379

# WebAuthn
WEBAUTHN_RP_ID=yourdomain.com
WEBAUTHN_RP_NAME=YourAppName
WEBAUTHN_ORIGIN=https://yourdomain.com

# Storage Node 1 (S3-compatible)
STORAGE_NODE1_ACCESS_KEY=
STORAGE_NODE1_SECRET_KEY=
STORAGE_NODE1_BUCKET=
STORAGE_NODE1_ENDPOINT=
STORAGE_NODE1_REGION=

# Storage Node 2 (S3-compatible)
STORAGE_NODE2_ACCESS_KEY=
STORAGE_NODE2_SECRET_KEY=
STORAGE_NODE2_BUCKET=
STORAGE_NODE2_ENDPOINT=
STORAGE_NODE2_REGION=

# Storage Node 3 (S3-compatible)
STORAGE_NODE3_ACCESS_KEY=
STORAGE_NODE3_SECRET_KEY=
STORAGE_NODE3_BUCKET=
STORAGE_NODE3_ENDPOINT=
STORAGE_NODE3_REGION=

# Replication
STORAGE_REPLICATION_FACTOR=2